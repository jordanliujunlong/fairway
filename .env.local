# ローカル開発用 .env
# このファイルを .env にコピーして使ってください: cp .env.local .env

# PostgreSQL（ローカル）
# docker-compose を使う場合はそのまま、手動インストールの場合は適宜変更
DATABASE_URL=postgresql://fairway:fairway_pass@localhost:5432/fairway_db

# JWT
JWT_SECRET=local-dev-secret-do-not-use-in-production

# CORS（フロントをブラウザで直接開く場合は * でOK）
FRONTEND_URL=*

# 開発モード
NODE_ENV=development

# Stripe テストキー（Stripeダッシュボード > 開発者 > APIキー から取得）
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
