# ── Railway が自動注入（手動設定不要）──
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Railway Variables に手動で設定 ──
NODE_ENV=production
JWT_SECRET=your-super-secret-key-change-this   # openssl rand -hex 32 で生成

# フロントエンドのURL（CORS用）
FRONTEND_URL=https://your-frontend.vercel.app

# ── Stripe ──
# Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx      # シークレットキー（サーバーのみ）
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx    # Webhook署名シークレット

# ※ フロントエンドの index.html にも以下を設定してください
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx  （公開可能キー）
